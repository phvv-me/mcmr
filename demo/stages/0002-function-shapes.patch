+def read_argument(arguments, name, expected, strict):
+    """Return the argument under `name`, refusing or coercing what does not fit."""
+    given = arguments.get(name)
+    if isinstance(given, expected):
+        return given
+    if strict:
+        raise ValueError(_REFUSAL)
+    return None
 
 
