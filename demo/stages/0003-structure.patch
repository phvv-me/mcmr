+"""What one running server was configured to do."""
+
+import uuid
+
+from .identity import ServerIdentity
+
+
+class ServerConfiguration:
+    """The choices a run makes, separate from the identity it announces."""
+
+    def __init__(self, identity=None, enabled_tools=None):
+        self.identity = identity if identity is not None else ServerIdentity()
+        self.enabled_tools = enabled_tools
+        self.verbose = False
+        self.strict = False
+        self.max_payload = 1048576
+        self.session_id = str(uuid.uuid4())
+
+    def is_tool_enabled(self, name):
+        """Whether this run answers calls to the named tool."""
+        return self.enabled_tools is None or name in self.enabled_tools
