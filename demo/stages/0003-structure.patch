diff --git a/demo/mcp/catalogue.py b/demo/mcp/catalogue.py
new file mode 100644
index 0000000..09ea1b4
--- /dev/null
+++ b/demo/mcp/catalogue.py
@@ -0,0 +1,50 @@
+"""What `tools/list` answers, built from one declaration per tool."""
+
+
+class ToolCatalogue:
+    """Hold what every tool is called, what it does, and what it takes."""
+
+    DECLARED = (
+        ("echo", "Return the text it was given.", "text"),
+        ("sum_numbers", "Add every number it was given.", "numbers"),
+        ("word_count", "Count the words in the text.", "text"),
+        ("slugify", "Turn the text into a slug.", "text"),
+        ("statistics", "Summarise the numbers.", "numbers"),
+    )
+
+    def __init__(self, config):
+        self.config = config
+
+    def describe_all(self):
+        """Return the `tools/list` payload for every tool this run enabled."""
+        return [
+            self.entry(name, description, argument)
+            for name, description, argument in self.DECLARED
+            if self.config.is_tool_enabled(name)
+        ]
+
+    def entry(self, name, description, argument):
+        """Describe one tool, choosing the schema its single argument needs."""
+        if argument == "numbers":
+            schema = self._number_schema(argument)
+        else:
+            schema = self._text_schema(argument)
+        return {"name": name, "description": description, "inputSchema": schema}
+
+    def _number_schema(self, property_name):
+        """Describe one required array-of-number property."""
+        items = {"type": "array", "items": {"type": "number"}, "description": "the numbers"}
+        return {
+            "type": "object",
+            "properties": {property_name: items},
+            "required": [property_name],
+        }
+
+    def _text_schema(self, property_name):
+        """Describe one required string property."""
+        described = {"type": "string", "description": "the text"}
+        return {
+            "type": "object",
+            "properties": {property_name: described},
+            "required": [property_name],
+        }
