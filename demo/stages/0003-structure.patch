new file mode 100644
index 0000000..42a5cc8
--- /dev/null
+++ b/demo/mcp/tools/arguments.py
@@ -0,0 +1,41 @@
+"""Read the one argument each tool takes, and say so when it does not fit."""
+
+import sys
+
+_MAX_TEXT = 100000
+_MAX_NUMBERS = 10000
+
+# The one refusal both readers raise, named once so they cannot drift apart.
+_REFUSAL = "the argument is missing or the wrong shape for this tool"
+
+
+def _warn(message, verbose):
+    """Say something on the error stream, which is the only stream a client is not reading."""
+    if verbose:
+        sys.stderr.write(message + "\n")
+
+
+def _read_argument(arguments, name, expected, strict):
+    """Return the argument under `name`, refusing or reporting nothing when it does not fit."""
+    given = arguments.get(name)
+    if isinstance(given, expected):
+        return given
+    if strict:
+        raise ValueError(_REFUSAL)
+    return None
+
+
+def read_text_argument(arguments, config, strict):
+    """Read the `text` argument as a bounded string, however it arrived."""
+    given = _read_argument(arguments, "text", str, strict)
+    text = "" if given is None else given
+    _warn("a tool received " + str(len(text)) + " characters", config.verbose)
+    return text[0:_MAX_TEXT]
+
+
+def read_number_argument(arguments, config, strict):
+    """Read the `numbers` argument as a bounded list of real numbers."""
+    given = _read_argument(arguments, "numbers", list, strict)
+    numbers = [] if given is None else given[0:_MAX_NUMBERS]
+    _warn("a tool received " + str(len(numbers)) + " numbers", config.verbose)
+    return [one for one in numbers if isinstance(one, (int, float)) and one is not True]
diff --git a/demo/mcp/tools/handlers.py b/demo/mcp/tools/handlers.py
new file mode 100644
index 0000000..eb1950d
--- /dev/null
+++ b/demo/mcp/tools/handlers.py
@@ -0,0 +1,54 @@
+"""The one line of work each of the five tools is actually for."""
+
+import json
+import re
+
+from .arguments import read_number_argument, read_text_argument
+
+
+def _median_of(sorted_numbers):
+    """Return the middle number, averaging the two middles of an even-length run."""
+    middle = len(sorted_numbers) // 2
+    if len(sorted_numbers) % 2 == 1:
+        return sorted_numbers[middle]
+    return (sorted_numbers[middle - 1] + sorted_numbers[middle]) / 2
+
+
+def run_echo_tool(arguments, config, strict):
+    """Return the text the caller sent."""
+    return read_text_argument(arguments, config, strict)
+
+
+def run_sum_tool(arguments, config, strict):
+    """Add every number the caller sent."""
+    return str(sum(read_number_argument(arguments, config, strict)))
+
+
+def run_word_count_tool(arguments, config, strict):
+    """Count the whitespace separated words in the text the caller sent."""
+    return str(len(read_text_argument(arguments, config, strict).split()))
+
+
+def run_slugify_tool(arguments, config, strict):
+    """Lower the text and join whatever is left with single hyphens."""
+    lowered = read_text_argument(arguments, config, strict).lower()
+    return re.sub(r"[^a-z0-9]+", "-", lowered).strip("-")
+
+
+def run_statistics_tool(arguments, config, strict):
+    """Summarise the numbers the caller sent with the five statistics this tool reports."""
+    numbers = sorted(read_number_argument(arguments, config, strict))
+    if not numbers:
+        return json.dumps({"count": 0})
+    mean = sum(numbers) / len(numbers)
+    variance = sum((one - mean) ** 2 for one in numbers) / len(numbers)
+    return json.dumps(
+        {
+            "count": len(numbers),
+            "min": numbers[0],
+            "max": numbers[-1],
+            "mean": mean,
+            "median": _median_of(numbers),
+            "variance": variance,
+        }
+    )
diff --git a/demo/mcp/tools/registry.py b/demo/mcp/tools/registry.py
new file mode 100644
index 0000000..f47e3ca
--- /dev/null
+++ b/demo/mcp/tools/registry.py
@@ -0,0 +1,25 @@
+"""Which handler answers which tool name."""
+
+from .handlers import (
+    run_echo_tool,
+    run_slugify_tool,
+    run_statistics_tool,
+    run_sum_tool,
+    run_word_count_tool,
+)
+
+_HANDLERS = {
+    "echo": run_echo_tool,
+    "sum_numbers": run_sum_tool,
+    "word_count": run_word_count_tool,
+    "slugify": run_slugify_tool,
+    "statistics": run_statistics_tool,
+}
+
+
+def run_tool_by_name(name, arguments, config, strict):
+    """Run the handler this name refers to, or report nothing for a name nobody registered."""
+    handler = _HANDLERS.get(name)
+    if handler is None:
+        return None
+    return handler(arguments, config, strict)
diff --git a/demo/mcp/transport.py b/demo/mcp/transport.py
new file mode 100644
index 0000000..27d1217
--- /dev/null
+++ b/demo/mcp/transport.py
@@ -0,0 +1,39 @@
+"""Newline delimited JSON over the standard streams."""
+
+import json
+import sys
+
+
+class StandardStreamTransportLayer:
+    """Read one JSON message per line and write one JSON message per line."""
+
+    def __init__(self, config, reader=None, writer=None):
+        self.config = config
+        self.reader = reader if reader is not None else sys.stdin
+        self.writer = writer if writer is not None else sys.stdout
+        self.messages_read = 0
+        self.messages_written = 0
+
+    def read_one_message(self):
+        """Return the next message, a marker for one this layer could not accept, or nothing."""
+        line = self.reader.readline()
+        if not line:
+            return None
+        stripped = line.strip()
+        if not stripped:
+            return self.read_one_message()
+        self.messages_read = self.messages_read + 1
+        if len(stripped) > self.config.max_payload:
+            return {"jsonrpc": "2.0", "id": None, "method": "__oversized__", "params": {}}
+        try:
+            return json.loads(stripped)
+        except json.JSONDecodeError:
+            return {"jsonrpc": "2.0", "id": None, "method": "__unparseable__", "params": {}}
+
+    def write_one_message(self, payload):
+        """Write one message and flush it, because a client is waiting on this line."""
+        encoded = json.dumps(payload)
+        self.writer.write(encoded + "\n")
+        self.writer.flush()
+        self.messages_written = self.messages_written + 1
+        return len(encoded)
