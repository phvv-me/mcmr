+"""What one run has done so far."""
+
+
+class RunCounters:
+    """The three totals a run reports when it is asked how it went."""
+
+    def __init__(self):
+        self.calls = 0
+        self.errors = 0
+        self.requests = 0
+
+    def rendered(self, session_id):
+        """Render the totals as the plain lines a operator reads on the error stream."""
+        return "\n".join(
+            [
+                "metrics since start",
+                "requests " + str(self.requests),
+                "errors " + str(self.errors),
+                "calls " + str(self.calls),
+                "session " + str(session_id),
+            ]
+        )
