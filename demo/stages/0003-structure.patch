diff --git a/demo/mcp/router.py b/demo/mcp/router.py
new file mode 100644
index 0000000..0e415a8
--- /dev/null
+++ b/demo/mcp/router.py
@@ -0,0 +1,138 @@
+"""Route one JSON-RPC message to the one method that answers it."""
+
+import sys
+import time
+
+from .catalogue import ToolCatalogue
+from .counters import RunCounters
+from .tools import run_tool_by_name
+
+# The one refusal every malformed or unroutable envelope gets, named once so all four agree.
+_REJECTED = "the request envelope could not be accepted"
+
+# The markers the transport layer puts on a message it read but could not accept.
+_MALFORMED = ("__unparseable__", "__oversized__")
+
+# TODO: resources/list and resources/read are still not implemented, so a client that
+# asks for a resource gets the method-not-found refusal below rather than a resource.
+
+
+class ProtocolServer:
+    """Answer MCP messages until the client stops sending them."""
+
+    def __init__(self, config, transport):
+        self.config = config
+        self.transport = transport
+        self.catalogue = ToolCatalogue(config)
+        self.counters = RunCounters()
+        self.initialized = False
+        self.shutdown_requested = False
+
+    def acknowledge(self, params, request_id):
+        """Record that the client finished initializing, which earns no reply."""
+        self._log("client finished initializing")
+        return None
+
+    def answer(self, message):
+        """Return the envelope one message earns, or nothing when it earns silence."""
+        request_id = message.get("id")
+        if message.get("method") in _MALFORMED:
+            return self._refuse(None, -32700)
+        if message.get("jsonrpc") != "2.0":
+            return self._refuse(request_id, -32600)
+        answered = self.routes().get(message.get("method"))
+        if answered is None:
+            if request_id is None:
+                return None
+            return self._refuse(request_id, -32601)
+        return answered(message.get("params") or {}, request_id)
+
+    def call_tool(self, params, request_id):
+        """Run the named tool and wrap whatever it produced as MCP text content."""
+        self.counters.calls = self.counters.calls + 1
+        name = params.get("name")
+        if self.config.is_tool_enabled(name) is False:
+            return self._refuse(request_id, -32602)
+        produced = self._produce(name, params.get("arguments") or {})
+        if produced is None:
+            return self._refuse(request_id, -32603)
+        body = {"content": [{"type": "text", "text": str(produced)}], "isError": False}
+        return self._result(request_id, body)
+
+    def greet(self, params, request_id):
+        """State the protocol version, the capabilities, and who this server is."""
+        self.initialized = True
+        identity = self.config.identity
+        greeting = {
+            "protocolVersion": identity.protocol_version,
+            "capabilities": {"tools": {"listChanged": False}},
+            "serverInfo": {"name": identity.name, "version": identity.version},
+            "instructions": identity.instructions,
+        }
+        return self._result(request_id, greeting)
+
+    def list_tools(self, params, request_id):
+        """List the enabled tools, unless a strict server was asked before it was ready."""
+        if self.initialized is False and self.config.strict:
+            return self._refuse(request_id, -32002)
+        return self._result(request_id, {"tools": self.catalogue.describe_all()})
+
+    def pong(self, params, request_id):
+        """Answer a liveness check with the empty result the protocol asks for."""
+        return self._result(request_id, {})
+
+    def routes(self):
+        """Map every JSON-RPC method this server answers to the method that answers it."""
+        return {
+            "initialize": self.greet,
+            "notifications/initialized": self.acknowledge,
+            "ping": self.pong,
+            "tools/list": self.list_tools,
+            "tools/call": self.call_tool,
+            "shutdown": self.stop,
+        }
+
+    def serve_forever(self):
+        """Answer one message at a time until the client stops sending them."""
+        while not self.shutdown_requested:
+            message = self.transport.read_one_message()
+            if message is None:
+                break
+            self.counters.requests = self.counters.requests + 1
+            answer = self.answer(message)
+            if answer is not None:
+                self.transport.write_one_message(answer)
+        return self.counters.requests
+
+    def stop(self, params, request_id):
+        """Let the loop finish after this reply reaches the client."""
+        self.shutdown_requested = True
+        return self._result(request_id, {})
+
+    def _error(self, request_id, code, message):
+        """State one failure in the envelope the JSON-RPC wire format asks for."""
+        return {"jsonrpc": "2.0", "id": request_id, "error": {"code": code, "message": message}}
+
+    def _log(self, message):
+        """Say something on the error stream, which is the stream no client is reading."""
+        if self.config.verbose:
+            sys.stderr.write(message + "\n")
+
+    def _produce(self, name, arguments):
+        """Run one tool, timing it, and read a refused argument as nothing produced."""
+        started = time.monotonic()
+        try:
+            produced = run_tool_by_name(name, arguments, self.config, self.config.strict)
+        except ValueError:
+            return None
+        self._log("ran " + name + " in " + str(round((time.monotonic() - started) * 1000)) + "ms")
+        return produced
+
+    def _refuse(self, request_id, code):
+        """Count one refusal and state it in the shape a client expects."""
+        self.counters.errors = self.counters.errors + 1
+        return self._error(request_id, code, _REJECTED)
+
+    def _result(self, request_id, body):
+        """State one successful result, keyed to the request that asked for it."""
+        return {"jsonrpc": "2.0", "id": request_id, "result": body}
