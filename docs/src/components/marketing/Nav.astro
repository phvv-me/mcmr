---
// Load the compact vector logo as source so the navigation stays crisp at every density.
const logoFiles = import.meta.glob('../../assets/logo.svg', {
  eager: true,
  query: '?raw',
  import: 'default',
});
const logo = Object.values(logoFiles)[0] as string | undefined;
---

<header class="border-base-300 bg-base-100/90 sticky top-0 z-50 border-b-2 backdrop-blur">
  <nav class="navbar mx-auto max-w-6xl px-4">
    <div class="navbar-start">
      <a href="/mcmr/" class="flex items-center" aria-label="mcmr">
        {
          logo ? (
            <span class="brand-mark h-8" set:html={logo} />
          ) : (
            <span class="flex items-center gap-2 text-lg font-black tracking-tight">
              <span
                class="bg-primary text-primary-content flex size-7 items-center justify-center text-sm font-black"
                aria-hidden="true"
              >
                M
              </span>
              <span style="font-family: var(--font-brand)">mcmr</span>
            </span>
          )
        }
      </a>
    </div>
    <div class="navbar-center hidden gap-1 lg:flex">
      <a href="#what" class="btn btn-ghost btn-sm">What it is</a>
      <a href="#demo" class="btn btn-ghost btn-sm">The demo</a>
      <a href="#datahub" class="btn btn-ghost btn-sm">DataHub</a>
      <a href="/mcmr/docs/" class="btn btn-ghost btn-sm">Docs</a>
    </div>
    <div class="navbar-end gap-2">
      <a
        href="https://github.com/phvv-me/mcmr"
        class="btn btn-ghost btn-sm"
        rel="noopener"
        aria-label="mcmr on GitHub"
      >
        <svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
      <a href="/mcmr/docs/start/install/" class="btn btn-primary btn-sm">Get started</a>
    </div>
  </nav>
</header>

<style>
  /* The logo carries its own fixed width and height attributes, so the wrapper's Tailwind height
     utility only constrains the span. Force the injected SVG to match it and derive its own width
     from the logo's real aspect ratio instead of stretching. */
  .brand-mark :global(svg) {
    display: block;
    height: 100%;
    width: auto;
  }
</style>
